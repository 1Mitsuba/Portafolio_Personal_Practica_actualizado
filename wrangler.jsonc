{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "portafolio-wendy",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
